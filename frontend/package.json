{
  "name": "mrrss-frontend",
  "private": true,
  "version": "1.3.43",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "prepare": "husky",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run",
    "test:component": "cypress open --component",
    "test:component:headless": "cypress run --component",
    "cypress": "cypress open",
    "cypress:headless": "cypress run",
    "test:e2e": "cypress run",
    "test:e2e:headed": "cypress open",
    "test:e2e:spec": "cypress run --spec",
    "test:all": "npm run test:unit && npm run test:e2e",
    "check:unused": "knip",
    "check:unused:json": "knip --json",
    "check:unused:fix": "knip --fix"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@phosphor-icons/vue": "^2.2.1",
    "dompurify": "3.4.17",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.4",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.18"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@cypress/vite-dev-server": "^8.0.0",
    "@cypress/vue": "^7.0.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.5.1",
    "@wailsio/runtime": "3.1.0",
    "autoprefixer": "^10.6.2",
    "cypress": "^16.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "ignore": [
      "wailsjs/**"
    ]
  }
}
